##
## Configuration for Mako, notification daemon for Wayland.
##
## --------------------------------------------------------

# GLOBAL CONFIGURATION OPTIONS
max-history=100
sort=-time

# BINDING OPTIONS
on-button-left=dismiss
on-button-middle=none
on-button-right=dismiss-all
on-touch=dismiss
on-notify=exec mpv /usr/share/sounds/freedesktop/stereo/message.oga

# STYLE OPTIONS
font=JetBrains Mono 10
width=300
height=100
margin=20
padding=15
border-size=2
border-radius=8
icons=1
max-icon-size=48
icon-location=left
markup=1
actions=1
history=1
text-alignment=left
default-timeout=5000
ignore-timeout=0
max-visible=5
layer=overlay
anchor=top-right

# Mako_Colors
background-color=#2D353B
text-color=#D3C6AA
border-color=#3f4a52
progress-color=over #A7C080

[urgency=low]
border-color=#3f4a52
default-timeout=2000

[urgency=normal]
border-color=#3f4a52
default-timeout=5000

[urgency=high]
border-color=#E67E80
text-color=#E67E80
default-timeout=0
